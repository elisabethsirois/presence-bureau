# ==========================================
# BASE DE DONNÉES (PostgreSQL - Neon / Vercel Postgres ou SQLite en local)
# ==========================================
# En local :
DATABASE_URL="file:./dev.db"

# En production avec Neon / Supabase :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ==========================================
# SÉCURITÉ & AUTHENTIFICATION
# ==========================================
# Clé secrète de chiffrement (générer avec: openssl rand -base64 32)
AUTH_SECRET="presence_bureau_secret_key_super_secure_12345"

# URL publique de l'application
NEXTAUTH_URL="http://localhost:3000"

# Politique d'inscription : "false" pour restreindre l'inscription aux invitations uniquement (recommandé)
# ou "true" pour permettre l'inscription publique avec vérification d'email
ALLOW_PUBLIC_REGISTRATION="false"

# ==========================================
# ENVOI DE COURRIELS (Optionnel)
# ==========================================
# Si aucune clé n'est fournie, le système fonctionne en mode SIMULATION LOCALE :
# les codes OTP et liens de vérification/invitation sont affichés dans la console.
# Fournisseur recommandé : Resend (https://resend.com)
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="onboarding@resend.dev"