# ==========================================
# BASE DE DONNÉES (PostgreSQL - Neon / Vercel Postgres)
# ==========================================
# Exemple avec Neon (gratuit sur https://neon.tech ou via Vercel Storage) :
# DATABASE_URL="postgresql://neondb_owner:xxxx@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ==========================================
# SÉCURITÉ & AUTHENTIFICATION (NextAuth / Sessions)
# ==========================================
# Clé secrète de chiffrement (générer avec: openssl rand -base64 32 ou une longue chaîne aléatoire)
AUTH_SECRET="presence_bureau_secret_key_super_secure_12345"

# URL de l'application
# En local : http://localhost:3000
# En production sur Vercel : https://votre-projet.vercel.app
NEXTAUTH_URL="http://localhost:3000"